write.csv(retail, "prueba.csv", row.names = FALSE)
orden_grupos <- datos_mensual %>%
group_by(Rango_edad) %>%
summarise(total = sum(gasto_por_mes)) %>%
arrange(desc(total)) %>%
pull(Rango_edad)
resumen <- datos_mensual %>%
mutate(Rango_edad = factor(Rango_edad, levels = orden_grupos))
ggplot(datos_mensual,
aes(x = mes,
y = gasto_por_mes)) +
geom_bar(stat = "identity", position = "stack", aes(fill = Rango_edad)) +
scale_x_date(
date_labels = "%b",
date_breaks = "1 month"
)
View(resumen)
ggplot(resumen,
aes(x = mes,
y = gasto_por_mes)) +
geom_bar(stat = "identity", position = "stack", aes(fill = Rango_edad)) +
scale_x_date(
date_labels = "%b",
date_breaks = "1 month"
)
