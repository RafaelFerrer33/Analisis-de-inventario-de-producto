ggplot(datos_mensual, aes(x = mes, y = gasto_por_mes, fill = Rango_edad, group = Rango_edad)) +
# 1. Barras con transparencia (para que se vean las de atrás)
geom_col(position = "identity", alpha = 0.3) +
# 2. El polígono de frecuencia (la línea que pedías)
geom_line(aes(color = Rango_edad), size = 1.2) +
# 3. Puntos en los nodos (como tu imagen de referencia)
geom_point(aes(color = Rango_edad), size = 2) +
# Configuración de los ejes (Meses abajo, Dinero en Y)
scale_x_date(date_labels = "%b", date_breaks = "1 month") +
scale_y_continuous(labels = scales::label_dollar()) +
# Colores combinados para que la línea y la barra coincidan
